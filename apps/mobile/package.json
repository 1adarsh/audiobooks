{
  "name": "@storybook-audio/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "build:android:debug-apk": "expo prebuild --platform android && cd android && ./gradlew assembleDebug",
    "build:android:apk": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@storybook-audio/shared": "0.1.0",
    "expo": "^58.0.0",
    "expo-av": "~15.1.7",
    "expo-constants": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "query-string": "^10.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@expo/config-plugins": "~58.0.11",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
