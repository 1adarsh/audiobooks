{
  "expo": {
    "name": "Storybook Audio",
    "slug": "storybook-audio",
    "scheme": "storybook-audio",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.storybookaudio.app",
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidSecurity"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/audiobooks"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
